{
  "manifest_version": 3,
  "name": "Coinbase Magician Overlay",
  "version": "1.0.1",
  "description": "Manual Coinbase overlay with AI Trade Engine signals, entry, target, stop, and copyable trade card.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.coinbase.com/*",
    "https://coinbase.com/*",
    "https://api.exchange.coinbase.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.coinbase.com/*", "https://coinbase.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coinbase Magician Overlay"
  }
}
