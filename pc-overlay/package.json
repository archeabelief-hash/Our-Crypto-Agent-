{
  "name": "twisted-psyche-crypto-pc",
  "version": "0.3.0",
  "description": "Twisted Psyche Crypto market-wide predictive scanner and movement overlay for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.twistedpsyche.crypto",
    "productName": "Twisted Psyche Crypto",
    "files": ["main.js", "index.html", "renderer.js", "shelf.js", "forecast.js", "scanner.js"],
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"oneClick": true, "perMachine": false, "allowElevation": true},
    "artifactName": "Twisted-Psyche-Crypto-${version}-${arch}.${ext}"
  }
}
